diff --git a/src/virtuoso_bridge/virtuoso/schematic/params.py b/src/virtuoso_bridge/virtuoso/schematic/params.py
index 669ef12..f54a65f 100644
--- a/src/virtuoso_bridge/virtuoso/schematic/params.py
+++ b/src/virtuoso_bridge/virtuoso/schematic/params.py
@@ -123,6 +123,44 @@ def _resolve_instance_master(
     return tuple(out.split("|", 1))  # type: ignore[return-value]
 
 
+
+def _sync_w_wf(params: dict[str, str]) -> dict[str, str]:
+    has_w = "w" in params
+    has_wf = "wf" in params
+    if not (has_w ^ has_wf):
+        return params
+    params = dict(params)
+    nf_str = params.get("nf") or params.get("fingers") or "1"
+    try:
+        nf = int(nf_str)
+    except ValueError:
+        nf = 1
+    if has_w and not has_wf:
+        params["wf"] = params["w"] if nf == 1 else _scale_eng(params["w"], 1.0 / nf)
+    elif has_wf and not has_w:
+        params["w"] = params["wf"] if nf == 1 else _scale_eng(params["wf"], nf)
+    return params
+
+
+def _scale_eng(eng_str: str, factor: float) -> str:
+    suffixes = {"T": 1e12, "G": 1e9, "M": 1e6, "k": 1e3, "K": 1e3,
+                "m": 1e-3, "u": 1e-6, "n": 1e-9, "p": 1e-12, "f": 1e-15}
+    s = eng_str.strip()
+    if s and s[-1] in suffixes:
+        val = float(s[:-1]) * suffixes[s[-1]]
+        suffix = s[-1]
+    else:
+        try:
+            val = float(s)
+        except ValueError:
+            return eng_str
+        suffix = ""
+    result = val * factor
+    if suffix:
+        return f"{result / suffixes[suffix]:.6g}{suffix}"
+    return f"{result:.6g}"
+
+
 def _run_batched_param_update(
     client: VirtuosoClient,
     schematic_lib: str,
@@ -133,6 +171,8 @@ def _run_batched_param_update(
     if not params:
         return {}
 
+    params = _sync_w_wf(params)
+
     param_list = " ".join(f'"{escape_skill_string(name)}"' for name in params)
     param_value_bindings = " ".join(
         f'setarray(paramVals "{escape_skill_string(name)}" "{escape_skill_string(value)}")'
